<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://kit.fontawesome.com/5e2b46074f.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/broadcastHome.css" />
    <link rel="shortcut icon" href="/bitimg.png" type="image/x-icon" />
    <title>Broadcast Home</title>
  </head>

  <body>
<div class="body">
  <div id="toast"></div>
  <div class="container">
    <% if (req.query.error) { %>
      <span id="popup"  style="color: red;"><h3><%= req.query.error%></h3></span>
    <% } %>
    <% if (req.query.message) { %>
      <span id="popup"  style="color: green;"><h3><%= req.query.message%></h3></span>
    <% } %>
    <h2>All Broadcast Groups</h2>
    <table>
      <thead>
        <tr>
          <th>Group Name</th>
          <th>View Members</th>
          <th>Send Broadcast</th>
          <th>Add Member/Admin</th>
          <th>Delete Group</th>
        </tr>
      </thead>
      <tbody>
        <% groups.forEach(group => { %>
          <tr>
            <td data-label="Groupname">
              <span><%= group.name %></span>
            </td>
             <td data-label="View group"> 
              <a href="/admin-broadcast/view/<%=group.name%>" style="color: green;"><i class="fa-solid fa-eye"></i></a>
            </td>
            <td data-label="Send broadcast"> 
              <form action="/admin-broadcast/send/<%=group.name%>" method="POST"  onsubmit="return confirmSend()">
                <textarea name="message" id="message" placeholder="Write message" style="margin-right: .4rem;"></textarea>
                <button class="delete-btn" style="color: blue;"><i class="fa-solid fa-paper-plane"></i></button>
              </form>
            </td>
            <td data-label="Add member/admin"> 
              <a href="" style="color: green;"><i class="fa-solid fa-user-plus"></i></a>
            </td>
            <td data-label="Delete group"> 
              <form action="/admin-broadcast/deleteOneGroup/<%=group.name%>?_method=DELETE" method="POST"  onsubmit="return confirmDelete()">
                <button class="delete-btn" style="color: red;"><i class="fa-solid fa-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>
  <script>
    function showToast(message) {
      const toast = document.getElementById("toast")
      toast.textContent = message
      toast.className = "show"
      setTimeout(() => {
        toast.className = toast.className.replace("show", "")
      }, 4000)
    }

    // JavaScript to hide the error message after 3 seconds
window.onload = function() {
  const popup = document.getElementById('popup')
  // console.log("there is an error:", popup)
  if (popup) {
    setTimeout(() => {
      popup.style.display = 'none'
    }, 3000) // 3 seconds
  }
}

  function confirmDelete() {
    return confirm("Are you sure you want to delete this group? This action is permanent and cannot be undone.")
  }
  function confirmSend() {
    return confirm("Are you sure you want to send a message to this group?")
  }
  </script>
  </body>
</html>
