<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <script src="https://kit.fontawesome.com/5e2b46074f.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="/adminops.css">
  <link rel="shortcut icon" href="/bitimg.png" type="image/x-icon">
  <title>Broadcast Admin Operations</title>
</head>

<body>
    <% if (req.query.error) { %>
        <span id="popup" style="color: red;"><h3><%= req.query.error%></h3></span>
    <% } %>
    <% if (req.query.message) { %>
        <span id="popup" style="color: green;"><h3><%= req.query.message%></h3></span>
    <% } %>

  <!-- Add Member to Group-->
  <form class="form-card" action="/admin-broadcast/addMember/<%=group.name%>" method="POST">
    <h3><i class="fa-solid fa-user-plus"></i> Add Member to <%=group.name%></h3>
    <select name="employee" id="employee" required>
      <option value="">-- Select an Employee --</option>
      <% employees.forEach(emp => { %>
        <option value="<%= emp.phone.split("whatsapp:")[1] %>"><%= emp.name %></option>
      <% }) %>
    </select>
    <button type="submit">Add Member</button>
  </form>

  <!-- Add/Revoke Admin to/from group-->
  <form class="form-card" action="/admin-broadcast/assign/<%=group.name%>" method="POST">
    <h3><i class="fa-solid fa-person-circle-exclamation"></i> Assign/Revoke Admin Role</h3>
    <select name="employee" id="employee" required>
      <option value="">-- Select an Employee --</option>
      <% employees.forEach(emp => { %>
      <option value="<%= emp.phone.split("whatsapp:")[1] %>"><%= emp.name %></option>
      <% }) %>
    </select>
    <select name="execute" required>
      <option value="assign">Assign Admin</option>
      <option value="revoke">Revoke Admin Status</option>
    </select>
    <button type="submit">Execute</button>
  </form>

<script>
    // JavaScript to hide the error message after 3 seconds
    window.onload = function() {
        const popup = document.getElementById('popup')
        // console.log("there is an error:", popup)
        if (popup) {
            setTimeout(() => {
                popup.style.display = 'none'
            }, 3000) // 3 seconds
        }
    }

    function confirmDelete() {
      return confirm("Are you sure you want to delete this? This action is permanent and cannot be undone.")
    }
</script>
</body>
</html>
